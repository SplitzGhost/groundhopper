{
  "name": "groundhopper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:phone": "concurrently -k -n app,api -c cyan,magenta \"vite --mode phone\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "stadiums": "node tools/geocode.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node tools/icons.ts",
    "data": "node --env-file-if-exists=.env tools/build-data.ts"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
