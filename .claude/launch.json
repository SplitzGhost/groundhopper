{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "groundhopper",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "groundhopper-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:phone"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "groundhopper-static",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:static"
      ],
      "port": 5174
    },
    {
      "name": "groundhopper-hopper",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "static",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    }
  ]
}
